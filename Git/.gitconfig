# Your Git identity is set at first run (see Initialize-Configuration) from your
# install-time input, so no personal identity is committed here. Set it yourself
# with: git config --global user.name "..."  /  git config --global user.email "..."
[user]
	name =
	email =
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[core]
	longpaths = true
# Set an upstream automatically only when the remote branch has the same name, so a branch made
# from origin/master never tracks it and a plain `git push` cannot land on master by accident.
[branch]
	autoSetupMerge = simple
# Machine-local overrides, read last so they win. A fork or another operating system puts its
# per-machine values (for example a different credential helper) in ~/.gitconfig.local; git
# ignores an include whose file does not exist, so a machine without one is unaffected.
[include]
	path = ~/.gitconfig.local
